# Replit configuration for Mahara. Press Run: installs, builds and starts the app on port 3000.
modules = ["nodejs-20"]
run = "npm run replit"
entrypoint = "server/index.js"

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
