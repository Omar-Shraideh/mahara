# Copy these into Replit Secrets (Tools > Secrets). Do not commit a real key.

# Claude via Replit AI Integrations needs nothing here: Replit sets AI_INTEGRATIONS_ANTHROPIC_BASE_URL
# and AI_INTEGRATIONS_ANTHROPIC_API_KEY when you connect "Anthropic (Replit managed)".

# Optional. Your own key instead (takes priority). Turns on real Claude grading. Without it Mahara uses its built-in rules and says so on screen.
ANTHROPIC_API_KEY=

# Optional. Model names (defaults shown).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_GRADER=claude-sonnet-5

# Optional. Set to false to start with an empty database instead of the fictional demo data.
SEED_DEMO_DATA=true

# Optional. Lets you reset the demo data from outside the Repl (see ENVIRONMENT.md).
DEMO_RESET_TOKEN=
