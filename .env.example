# Copy these into Replit Secrets (Tools > Secrets). Do not commit a real key.

# Optional. Turns on real Claude grading. Without it Mahara uses its built-in rules and says so on screen.
ANTHROPIC_API_KEY=

# Optional. Model names (defaults shown).
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_GRADER=claude-sonnet-5-5

# Optional. Set to false to start with an empty database instead of the fictional demo data.
SEED_DEMO_DATA=true

# Optional. Lets you reset the demo data from outside the Repl (see ENVIRONMENT.md).
DEMO_RESET_TOKEN=
